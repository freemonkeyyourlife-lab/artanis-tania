{
  "name": "Dock",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "appearance": {
      "type": "string"
    },
    "greeting": {
      "type": "string"
    },
    "personaPrompt": {
      "type": "string"
    },
    "personaType": {
      "type": "string",
      "enum": [
        "SOLO_MALE",
        "SOLO_FEMALE",
        "COUPLE",
        "GROUP"
      ],
      "default": "SOLO_FEMALE"
    },
    "blendWith": {
      "type": "string",
      "enum": [
        "ARTANIS",
        "TANIA",
        "COUPLE",
        "NONE"
      ],
      "default": "COUPLE"
    },
    "blendStrength": {
      "type": "number",
      "default": 60
    },
    "rawInput": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "fileUrl": {
      "type": "string"
    },
    "avatar": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "submittedByName": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "DEACTIVATED"
      ],
      "default": "PENDING"
    },
    "reviewNote": {
      "type": "string"
    },
    "creatorId": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.status": "APPROVED"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}