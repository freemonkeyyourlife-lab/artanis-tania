{
  "name": "SzenenVorlage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name der Vorlage, z. B. \u201eAlltags-Check\u201c, \u201eSturm-Session\u201c oder \u201eKuschel-Kombi\u201c."
    },
    "purpose": {
      "type": "string",
      "enum": [
        "BILD",
        "SITZUNG",
        "MEDIEN",
        "CHAT",
        "VORSTELLUNG",
        "KOMBI"
      ],
      "default": "BILD",
      "description": "Was die Vorlage b\u00fcndelt: BILD (Posen/Szenen), SITZUNG (Therapie-Setup), MEDIEN (Video/Audio/Bild-Links), CHAT (Verweis auf Chats), VORSTELLUNG (freier Text), KOMBI (alles zusammen)."
    },
    "mode": {
      "type": "string",
      "enum": [
        "scenes",
        "poseSet"
      ],
      "default": "scenes"
    },
    "auswahl": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ausgew\u00e4hlte Posen- und Szenen-Schl\u00fcssel, die beim Laden vorausgef\u00fcllt werden."
    },
    "extra": {
      "type": "string",
      "description": "Freie Szene, die im Szenen-Modus dazu geh\u00f6rt."
    },
    "setup": {
      "type": "object",
      "description": "Komplettes Sitzungs-Setup f\u00fcr purpose=SITZUNG/KOMBI: Rollen, Stimmen, Modus, Intensit\u00e4t, Besetzung.",
      "properties": {
        "roleSetup": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "intensity": {
          "type": "string"
        },
        "therapistName": {
          "type": "string"
        },
        "therapistAge": {
          "type": "number"
        },
        "therapistType": {
          "type": "string"
        },
        "therapistStyle": {
          "type": "string"
        },
        "therapistRole": {
          "type": "string"
        },
        "therapistVoice": {
          "type": "string"
        },
        "cast": {
          "type": "array"
        },
        "actor": {
          "type": "object"
        },
        "topic": {
          "type": "string"
        }
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "VIDEO",
              "AUDIO",
              "BILD"
            ]
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Verlinktes vorhandenes Material \u2014 Videos, Audios, Bilder \u2014 f\u00fcr MEDIEN- und KOMBI-Vorlagen."
    },
    "chats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Verweise auf bestehende Chats f\u00fcr CHAT- und KOMBI-Vorlagen."
    },
    "vorstellung": {
      "type": "string",
      "description": "Freie Vorstellung als Text \u2014 f\u00fcr VORSTELLUNG- und KOMBI-Vorlagen."
    },
    "note": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}