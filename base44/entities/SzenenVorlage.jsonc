{
  "name": "SzenenVorlage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name des Szenen-Pakets, z. B. \u201eAlltags-Check\u201c oder \u201eWinter-Suiten\u201c."
    },
    "purpose": {
      "type": "string",
      "enum": [
        "BILD",
        "SITZUNG"
      ],
      "default": "BILD",
      "description": "Wof\u00fcr die Vorlage gedacht ist: BILD f\u00fcrs Bild-Studio (Posen/Szenen), SITZUNG f\u00fcr ein komplettes Therapie-Setup (Rollen, Stimmen, Modus)."
    },
    "mode": {
      "type": "string",
      "enum": [
        "scenes",
        "poseSet"
      ],
      "default": "scenes"
    },
    "auswahl": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ausgew\u00e4hlte Posen- und Szenen-Schl\u00fcssel, die beim Laden vorausgef\u00fcllt werden."
    },
    "extra": {
      "type": "string",
      "description": "Freie Szene, die im Szenen-Modus dazu geh\u00f6rt."
    },
    "setup": {
      "type": "object",
      "description": "Komplettes Sitzungs-Setup f\u00fcr purpose=SITZUNG: Rollen, Stimmen, Modus, Intensit\u00e4t, Besetzung.",
      "properties": {
        "roleSetup": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "intensity": {
          "type": "string"
        },
        "therapistName": {
          "type": "string"
        },
        "therapistAge": {
          "type": "number"
        },
        "therapistType": {
          "type": "string"
        },
        "therapistStyle": {
          "type": "string"
        },
        "therapistRole": {
          "type": "string"
        },
        "therapistVoice": {
          "type": "string"
        },
        "cast": {
          "type": "array"
        },
        "actor": {
          "type": "object"
        },
        "topic": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}