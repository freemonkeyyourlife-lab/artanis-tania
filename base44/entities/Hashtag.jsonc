{
  "name": "Hashtag",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "meaning": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "ALLGEMEIN",
        "FIGUR",
        "BILD",
        "VIDEO",
        "TEXT",
        "STORY"
      ],
      "default": "ALLGEMEIN"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "meaning"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}