{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversationId": {
      "type": "string"
    },
    "sender": {
      "type": "string"
    },
    "senderType": {
      "type": "string",
      "enum": [
        "HUMAN",
        "AI",
        "SYSTEM"
      ]
    },
    "text": {
      "type": "string"
    },
    "attachment": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "contentLink": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "humanOverride": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conversationId",
    "senderType"
  ]
}