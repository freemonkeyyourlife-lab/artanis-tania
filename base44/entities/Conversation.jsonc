{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "userName": {
      "type": "string"
    },
    "creatorId": {
      "type": "string"
    },
    "creatorName": {
      "type": "string"
    },
    "participantId": {
      "type": "string"
    },
    "participantName": {
      "type": "string"
    },
    "conversationType": {
      "type": "string",
      "enum": [
        "AI",
        "HUMAN"
      ],
      "default": "AI"
    },
    "scenario": {
      "type": "object"
    },
    "setupAnswers": {
      "type": "object"
    },
    "lastMessageAt": {
      "type": "string",
      "format": "date-time"
    },
    "unreadCount": {
      "type": "number",
      "default": 0
    },
    "handledBy": {
      "type": "string",
      "enum": [
        "AI",
        "HUMAN"
      ],
      "default": "AI"
    },
    "waitingSince": {
      "type": "string",
      "format": "date-time"
    },
    "lastGuestMessageAt": {
      "type": "string",
      "format": "date-time"
    },
    "notifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "voiceProfileId": {
      "type": "string"
    },
    "voiceNotes": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "userId"
  ]
}