{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "creatorId": {
      "type": "string"
    },
    "creatorName": {
      "type": "string"
    },
    "participantId": {
      "type": "string"
    },
    "participantName": {
      "type": "string"
    },
    "conversationType": {
      "type": "string",
      "enum": [
        "AI",
        "HUMAN"
      ],
      "default": "AI"
    },
    "lastMessageAt": {
      "type": "string",
      "format": "date-time"
    },
    "unreadCount": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "userId"
  ]
}