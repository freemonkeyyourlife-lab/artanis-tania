{
  "name": "TrainingSet",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "personName": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "SAMMLUNG",
        "BEREIT",
        "TRAINIERT"
      ],
      "default": "SAMMLUNG"
    },
    "targetCount": {
      "type": "number",
      "default": 12
    },
    "note": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generatedImages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceMedia": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avatar": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "personName"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}