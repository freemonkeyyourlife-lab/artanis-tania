{
  "name": "Neigung",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "kurz": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "speed": {
      "type": "number",
      "default": 0
    },
    "depth": {
      "type": "number",
      "default": 0
    },
    "style": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "key",
    "label"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}