{
  "name": "SiteLayout",
  "type": "object",
  "properties": {
    "navItems": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "navFontSize": {
      "type": "number",
      "default": 15
    },
    "navFontWeight": {
      "type": "number",
      "default": 700
    },
    "navGap": {
      "type": "number",
      "default": 8
    },
    "ownerName": {
      "type": "string"
    },
    "introEnabled": {
      "type": "boolean",
      "default": true
    },
    "infoEnabled": {
      "type": "boolean",
      "default": true
    },
    "introSteps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "interestOptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "infoTexts": {
      "type": "object"
    },
    "ownerLastSeenAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}