{
  "name": "SiteLayout",
  "type": "object",
  "properties": {
    "navItems": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "structure": {
      "type": "object",
      "properties": {
        "areas": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "studioLayout": {
      "type": "object"
    },
    "navFontSize": {
      "type": "number",
      "default": 15
    },
    "navFontWeight": {
      "type": "number",
      "default": 700
    },
    "navGap": {
      "type": "number",
      "default": 8
    },
    "ownerName": {
      "type": "string"
    },
    "introEnabled": {
      "type": "boolean",
      "default": true
    },
    "infoEnabled": {
      "type": "boolean",
      "default": true
    },
    "introSteps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "interestOptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "infoTexts": {
      "type": "object"
    },
    "askGender": {
      "type": "boolean",
      "default": true
    },
    "askOrientation": {
      "type": "boolean",
      "default": true
    },
    "genderOptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "orientationOptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "greetingText": {
      "type": "string"
    },
    "guideBehavior": {
      "type": "string"
    },
    "guideVoice": {
      "type": "string",
      "enum": [
        "river",
        "honey",
        "sunny",
        "storm",
        "spark"
      ],
      "default": "honey"
    },
    "ownerLastSeenAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}