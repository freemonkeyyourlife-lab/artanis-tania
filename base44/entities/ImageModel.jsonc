{
  "name": "ImageModel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "HUGGING_FACE",
        "POLLINATIONS"
      ],
      "default": "HUGGING_FACE"
    },
    "preset": {
      "type": "string",
      "enum": [
        "PONY",
        "BIGASP",
        "EPIC",
        "ALLGEMEIN"
      ],
      "default": "ALLGEMEIN"
    },
    "note": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "modelId"
  ]
}