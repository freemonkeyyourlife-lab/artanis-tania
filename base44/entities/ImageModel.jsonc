{
  "name": "ImageModel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "HUGGING_FACE",
        "POLLINATIONS",
        "FAL_AI",
        "EXTERN"
      ],
      "default": "HUGGING_FACE"
    },
    "preset": {
      "type": "string",
      "enum": [
        "PONY",
        "ILLUSTRIOUS",
        "BIGASP",
        "EPIC",
        "ALLGEMEIN"
      ],
      "default": "ALLGEMEIN"
    },
    "style": {
      "type": "string",
      "enum": [
        "FOTOREAL",
        "ANIME",
        "ILLUSTRATION",
        "COMIC",
        "RENDER_3D",
        "GEMISCHT"
      ]
    },
    "explicit": {
      "type": "string",
      "enum": [
        "ZAHM",
        "ANZUEGLICH",
        "SINNLICH",
        "EXPLIZIT",
        "HART"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "moods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "favorite": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "modelId"
  ]
}