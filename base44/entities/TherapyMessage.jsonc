{
  "name": "TherapyMessage",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string"
    },
    "senderType": {
      "type": "string",
      "enum": [
        "USER",
        "AI",
        "GUEST",
        "SYSTEM"
      ]
    },
    "senderName": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "audio": {
      "type": "string",
      "description": "Echte Stimme des Senders \u2014 beim Einsprechen mitgeschnitten, statt nur Text."
    },
    "channel": {
      "type": "string",
      "enum": [
        "THERAPY",
        "SIDE"
      ],
      "default": "THERAPY"
    }
  },
  "required": [
    "sessionId",
    "senderType"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}