{
  "name": "Character",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "adultAge": {
      "type": "number",
      "minimum": 18
    },
    "createdByRole": {
      "type": "string",
      "enum": [
        "DAVID",
        "GAST"
      ],
      "default": "GAST"
    },
    "fictional": {
      "type": "boolean",
      "default": true
    },
    "sourceConsentVerified": {
      "type": "boolean",
      "default": false
    },
    "appearance": {
      "type": "string"
    },
    "art": {
      "type": "string"
    },
    "behavior": {
      "type": "string"
    },
    "understanding": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "relationship": {
      "type": "string"
    },
    "neigungen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voiceId": {
      "type": "string"
    },
    "moduleIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avatar": {
      "type": "string"
    },
    "backgroundImage": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "adultAge"
  ]
}