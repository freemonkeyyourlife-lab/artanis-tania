{
  "name": "Story",
  "type": "object",
  "properties": {
    "creatorId": {
      "type": "string"
    },
    "creatorName": {
      "type": "string"
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "preview": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "IMAGE",
              "VIDEO",
              "AUDIO"
            ],
            "default": "IMAGE"
          }
        }
      }
    },
    "madeWithUser": {
      "type": "boolean",
      "default": false
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "visibility": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "REGISTERED",
        "FREE_MEMBER",
        "VIP",
        "PPV",
        "INVITE_ONLY",
        "PRIVATE",
        "UNLISTED"
      ],
      "default": "PUBLIC"
    },
    "series": {
      "type": "string"
    },
    "episode": {
      "type": "number"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "creatorId",
    "title"
  ]
}