{
  "name": "TextModel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "style": {
      "type": "string",
      "enum": [
        "ERZAEHLEND",
        "DIALOG",
        "ROLLENSPIEL",
        "ANALYTISCH",
        "SACHLICH"
      ]
    },
    "explicit": {
      "type": "string",
      "enum": [
        "ZAHM",
        "ANZUEGLICH",
        "SINNLICH",
        "EXPLIZIT",
        "HART"
      ]
    },
    "moods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "favorite": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "modelId"
  ]
}