{
  "name": "ModelLink",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "BILD",
        "TEXT",
        "VIDEO",
        "AUDIO",
        "3D",
        "REALTIME",
        "EMBEDDING"
      ],
      "default": "BILD"
    },
    "io": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "favorite": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "url"
  ]
}