{
  "name": "FigureAxis",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "KOERPER",
        "GESICHT",
        "WESEN",
        "KLEIDUNG",
        "ROLLE",
        "DETAIL"
      ],
      "default": "KOERPER"
    },
    "gender": {
      "type": "string",
      "enum": [
        "ALLGEMEIN",
        "FRAU",
        "MANN"
      ],
      "default": "ALLGEMEIN"
    },
    "hint": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}