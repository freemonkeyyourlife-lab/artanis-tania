{
  "name": "VideoModel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "style": {
      "type": "string",
      "enum": [
        "FOTOREAL",
        "ANIME",
        "ILLUSTRATION",
        "COMIC",
        "RENDER_3D",
        "GEMISCHT"
      ]
    },
    "explicit": {
      "type": "string",
      "enum": [
        "ZAHM",
        "ANZUEGLICH",
        "SINNLICH",
        "EXPLIZIT",
        "HART"
      ]
    },
    "charakter": {
      "type": "string",
      "enum": [
        "HEISS",
        "DENKERISCH",
        "FAKTISCH",
        "KALT"
      ],
      "description": "Wof\u00fcr dieses Modell steht: hei\u00df, denkerisch, faktisch oder kalt."
    },
    "mass": {
      "type": "number",
      "default": 0,
      "description": "In welchem Ma\u00df der Charakter ausgepr\u00e4gt ist: 1 leicht, 2 mittel, 3 stark. 0 = nicht gesetzt."
    },
    "moods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "modelId"
  ]
}