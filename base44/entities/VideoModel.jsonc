{
  "name": "VideoModel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "style": {
      "type": "string",
      "enum": [
        "FOTOREAL",
        "ANIME",
        "ILLUSTRATION",
        "COMIC",
        "RENDER_3D",
        "GEMISCHT"
      ]
    },
    "explicit": {
      "type": "string",
      "enum": [
        "ZAHM",
        "ANZUEGLICH",
        "SINNLICH",
        "EXPLIZIT",
        "HART"
      ]
    },
    "moods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "modelId"
  ]
}