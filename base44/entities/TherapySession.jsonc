{
  "name": "TherapySession",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "userName": {
      "type": "string"
    },
    "anonymous": {
      "type": "boolean",
      "default": false
    },
    "roleSetup": {
      "type": "string",
      "enum": [
        "TRIANIA_THERAPIST",
        "USER_THERAPIST",
        "BOTH_PROBANDS"
      ],
      "default": "TRIANIA_THERAPIST"
    },
    "mode": {
      "type": "string",
      "enum": [
        "GUIDED",
        "OPEN",
        "ROLEPLAY",
        "R\u00dcCKBLICK"
      ],
      "default": "GUIDED"
    },
    "format": {
      "type": "string",
      "enum": [
        "EINZEL",
        "SERIE"
      ],
      "default": "EINZEL"
    },
    "seriesTitle": {
      "type": "string"
    },
    "episodeNumber": {
      "type": "number",
      "default": 1
    },
    "episodeCount": {
      "type": "number"
    },
    "topic": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "agenda": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "clientAge": {
      "type": "string"
    },
    "agreement": {
      "type": "string"
    },
    "therapistId": {
      "type": "string"
    },
    "therapistName": {
      "type": "string"
    },
    "therapistAvatar": {
      "type": "string"
    },
    "therapistAge": {
      "type": "number"
    },
    "therapistType": {
      "type": "string"
    },
    "therapistStyle": {
      "type": "string"
    },
    "therapistRole": {
      "type": "string"
    },
    "therapistVoice": {
      "type": "string",
      "enum": [
        "river",
        "honey",
        "sunny",
        "storm",
        "spark"
      ],
      "default": "honey"
    },
    "actor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "age": {
          "type": "number"
        },
        "setting": {
          "type": "string"
        },
        "voice": {
          "type": "string",
          "enum": [
            "river",
            "honey",
            "sunny",
            "storm",
            "spark"
          ],
          "default": "storm"
        },
        "active": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "intensity": {
      "type": "string",
      "enum": [
        "SANFT",
        "TIEF",
        "SCHONUNGSLOS"
      ],
      "default": "TIEF"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "DONE"
      ],
      "default": "OPEN"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "PRIVATE",
        "PUBLIC"
      ],
      "default": "PUBLIC"
    },
    "liveMode": {
      "type": "string",
      "enum": [
        "OFF",
        "CAM",
        "STREAM"
      ],
      "default": "OFF"
    },
    "liveToken": {
      "type": "string"
    },
    "lastMessageAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "topic"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.visibility": "PUBLIC"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}