{
  "name": "ChannelContact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "telegram": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "favorite": {
      "type": "boolean",
      "default": false
    },
    "lastContactedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}