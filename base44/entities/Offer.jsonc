{
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "creatorId": {
      "type": "string"
    },
    "conversationId": {
      "type": "string"
    },
    "offerType": {
      "type": "string",
      "enum": [
        "LIST_PRICE",
        "PERSONAL_OFFER",
        "USER_BID",
        "COUNTER_OFFER"
      ]
    },
    "targetType": {
      "type": "string",
      "enum": [
        "CONTENT",
        "STORY",
        "INTERACTIVE",
        "VIDEOCHAT",
        "CUSTOM_CONTENT",
        "PHYSICAL",
        "MEETING",
        "OTHER"
      ]
    },
    "targetId": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "minAllowed": {
      "type": "number"
    },
    "maxAllowed": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACCEPTED",
        "REJECTED",
        "COUNTERED",
        "EXPIRED",
        "PAID",
        "CANCELLED"
      ]
    },
    "createdBy": {
      "type": "string",
      "enum": [
        "USER",
        "AI",
        "CREATOR",
        "ADMIN"
      ]
    },
    "requiresManualApproval": {
      "type": "boolean"
    },
    "expiresAt": {
      "type": "string"
    },
    "paymentLinkToken": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    }
  },
  "required": [
    "userId",
    "creatorId",
    "offerType",
    "targetType",
    "amount",
    "currency",
    "status",
    "createdBy"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "Offer"
}