{
  "name": "UserPreference",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "gender": {
      "type": "string"
    },
    "orientation": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "avatar": {
      "type": "string"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topicsToDiscuss": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sexualPreferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "whatTheyWantToSee": {
      "type": "string"
    },
    "fantasyDescription": {
      "type": "string"
    },
    "userReferenceImages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "startImages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "therapySummaries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "userId"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}