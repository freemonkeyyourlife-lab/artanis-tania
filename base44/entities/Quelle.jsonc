{
  "name": "Quelle",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "BILD",
        "VIDEO",
        "AUDIO",
        "GIF",
        "TEXT",
        "STORY",
        "STIMME",
        "MODELL",
        "CHARAKTER",
        "FUNKTION"
      ],
      "default": "BILD"
    },
    "fileUri": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "UPLOAD",
        "EXTRAKT",
        "GENERIERT",
        "LINK"
      ],
      "default": "UPLOAD"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}