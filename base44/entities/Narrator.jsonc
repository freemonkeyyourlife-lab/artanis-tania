{
  "name": "Narrator",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "WEIBLICH",
        "MAENNLICH"
      ],
      "default": "WEIBLICH"
    },
    "kind": {
      "type": "string",
      "enum": [
        "ERZAEHLERIN",
        "BEGLEITERIN",
        "BERATERIN",
        "VERFUHRERIN",
        "BEOBACHTERIN"
      ],
      "default": "ERZAEHLERIN"
    },
    "personality": {
      "type": "string"
    },
    "appearance": {
      "type": "string"
    },
    "voice": {
      "type": "string",
      "enum": [
        "river",
        "honey",
        "sunny",
        "storm",
        "spark"
      ],
      "default": "honey"
    },
    "voiceProfileId": {
      "type": "string"
    },
    "artStyle": {
      "type": "string",
      "enum": [
        "PHOTOREAL",
        "CARTOON"
      ],
      "default": "PHOTOREAL"
    },
    "avatar": {
      "type": "string"
    },
    "imagePrompt": {
      "type": "string"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referenceImages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lines": {
      "type": "object",
      "properties": {
        "greeting": {
          "type": "string"
        },
        "between": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recall": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "regie": {
      "type": "object",
      "properties": {
        "autoSpeak": {
          "type": "boolean",
          "default": true
        },
        "firstAfter": {
          "type": "number",
          "default": 45
        },
        "gap": {
          "type": "number",
          "default": 150
        },
        "bubble": {
          "type": "number",
          "default": 14
        },
        "showName": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}