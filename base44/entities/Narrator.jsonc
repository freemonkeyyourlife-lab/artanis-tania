{
  "name": "Narrator",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "WEIBLICH",
        "MAENNLICH"
      ],
      "default": "WEIBLICH"
    },
    "kind": {
      "type": "string",
      "enum": [
        "ERZAEHLERIN",
        "BEGLEITERIN",
        "BERATERIN",
        "VERFUHRERIN",
        "BEOBACHTERIN"
      ],
      "default": "ERZAEHLERIN"
    },
    "personality": {
      "type": "string"
    },
    "voice": {
      "type": "string",
      "enum": [
        "river",
        "honey",
        "sunny",
        "storm",
        "spark"
      ],
      "default": "honey"
    },
    "artStyle": {
      "type": "string",
      "enum": [
        "PHOTOREAL",
        "CARTOON"
      ],
      "default": "PHOTOREAL"
    },
    "avatar": {
      "type": "string"
    },
    "referenceImages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}