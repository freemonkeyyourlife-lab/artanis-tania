{
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "LOVENSE",
        "BUTTPLUG",
        "KIIROO",
        "OTHER"
      ]
    },
    "model": {
      "type": "string"
    },
    "externalDeviceId": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "connectionStatus": {
      "type": "string",
      "enum": [
        "DISCONNECTED",
        "CONNECTED",
        "ERROR"
      ]
    },
    "aiControlAllowed": {
      "type": "boolean"
    },
    "creatorOnly": {
      "type": "boolean"
    },
    "coinActionsAllowed": {
      "type": "boolean"
    },
    "maxIntensity": {
      "type": "number"
    },
    "maxActionSeconds": {
      "type": "number"
    },
    "allowedPatterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sessionTimeoutSeconds": {
      "type": "number"
    },
    "consentRemoteControl": {
      "type": "boolean"
    },
    "consentUpdatedAt": {
      "type": "string"
    },
    "lastSeenAt": {
      "type": "string"
    }
  },
  "required": [
    "userId",
    "provider"
  ],
  "rls": {
    "create": {
      "data.userId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "ToyDevice"
}